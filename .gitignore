# Never commit copyrighted material: disc images, extracted game files, or
# anything derived from them that contains original code or assets.
*.iso
*.ISO
extracted/
asm/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Lifted code is a mechanical translation, regenerated in minutes by
# engine/tools/lift.py --emit; committing it would add megabytes per run.
games/*/src/lifted/
