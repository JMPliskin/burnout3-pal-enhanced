# Never commit copyrighted material: disc images, extracted game files, or
# anything derived from them that contains original code or assets.
*.iso
*.ISO
extracted/
asm/
build/
# Release packages (games/<name>/port/tools/package.py writes them under build/).
*.zip
# The user's console BIOS dumps (PCSX2 references): never committed.
bios/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# A game's own code in C++ - lifted (a mechanical translation), derived and
# reconstructed - is the game's, and regenerated from the player's disc by the
# tools (lift.py --emit, derive.py --emit): never committed.
games/*/src/
games/*/include/*/
!games/*/include/ps2/

# Texture packs (PCSX2 replacements: third-party art made from the game's textures): never committed.
replacements/
texture pack/
texture_pack/

# Burnout 3 PAL Enhanced
# Private game data and generated content

# Disc images
*.iso
*.ISO
*.chd
*.CHD

# PAL original executable
SLES_525.84
SLES_525.84.*

# Locally extracted game data
games/burnout3-pal/extracted/
games/burnout3-pal/build/
games/burnout3-pal/generated/

# Local backups
*.bak
*.backup

# Environment files
.env
.env.*
!.env.example

# Logs and crash dumps
*.log
*.dmp
*.mdmp
ram.bin

# Local native build outputs, including accidentally placed outputs outside build/.
*.[eE][xX][eE]
*.[dD][lL][lL]
*.obj
*.o
*.pdb
*.ilk
*.pch
*.lib
*.exp
*.tmp
*.temp
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Original console executables/modules. Do not ignore arbitrary .bin/.json
# or image fixtures: public manifests and synthetic tests must remain visible.
*.[eE][lL][fF]
*.[iI][rR][xX]
SLUS_210.50

# PAL runtime output locations and conventional generated VU filenames.
games/burnout3-pal/port/generated/
games/burnout3-pal/captures/
games/burnout3-pal/diagnostics/
games/burnout3-pal/saves/
games/burnout3-pal/vu_programs.txt
games/burnout3-pal/**/vu_blocks_*.cpp
games/burnout3-pal/**/vu_programs.cpp
games/burnout3-pal/**/vu_programs.txt

# Private workspace/backups if created inside a checkout by mistake.
/PAL-Workspace/
/Archives/
/.private/
/backups/
/captures/
/diagnostics/
/memcards/
/saves/

# Historical private launchers remain on disk, outside the public source tree.
/Jugar Burnout 3 PAL.bat
/Jugar Burnout 3 PAL FMV.bat
/Jugar Burnout 3 PAL VU compilado.bat
/Jugar Burnout 3 PAL anterior.bat
/Capturar VU Burnout 3 PAL.bat
