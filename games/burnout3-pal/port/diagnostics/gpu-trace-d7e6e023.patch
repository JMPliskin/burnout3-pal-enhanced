diff --git a/gpu/include/ps2gpu/trace_probe.h b/gpu/include/ps2gpu/trace_probe.h
new file mode 100644
--- /dev/null
+++ b/gpu/include/ps2gpu/trace_probe.h
@@ -0,0 +1,34 @@
+#pragma once
+// Diagnostic only: bounded in-memory events, written at the host report.
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+namespace ps2gpu { namespace trace_probe {
+struct Event { unsigned long long sequence, ns, thread, a, b, c, d, e; const char* tag; };
+inline std::array<Event,2048> history{};
+inline std::mutex mutex;
+inline unsigned long long sequence=0;
+inline bool Enabled() { static const bool enabled=std::getenv("PS2HOST_GPU_TRACE")!=nullptr; return enabled; }
+inline bool Sample(unsigned long long n) { return n<=8 || n%120==0; }
+inline void Record(const char* tag,unsigned long long a=0,unsigned long long b=0,unsigned long long c=0,unsigned long long d=0,unsigned long long e=0) {
+ if(!Enabled()) return;
+ const auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+ const auto thread=std::hash<std::thread::id>{}(std::this_thread::get_id());
+ std::lock_guard<std::mutex> lock(mutex); const auto n=sequence++;
+ history[n%history.size()]={n,(unsigned long long)ns,(unsigned long long)thread,a,b,c,d,e,tag};
+}
+inline void Dump() {
+ if(!Enabled())return;
+ static std::atomic<bool> dumped{false}; if(dumped.exchange(true))return;
+ std::array<Event,2048> copy; unsigned long long end;
+ { std::lock_guard<std::mutex> lock(mutex);copy=history;end=sequence; }
+ FILE* file=std::fopen(std::getenv("PS2HOST_GPU_TRACE"),"wb");if(!file)return;
+ for(auto n=end>copy.size()?end-copy.size():0;n<end;++n){const auto& x=copy[n%copy.size()];
+ std::fprintf(file,"{\"seq\":%llu,\"ns\":%llu,\"thread\":%llu,\"event\":\"%s\",\"v\":[%llu,%llu,%llu,%llu,%llu]}\n",x.sequence,x.ns,x.thread,x.tag,x.a,x.b,x.c,x.d,x.e);}
+ std::fclose(file);
+}
+} }
