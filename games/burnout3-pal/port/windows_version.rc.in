#include <windows.h>
1 VERSIONINFO
FILEVERSION @PAL_PLAYER_FIXED_VERSION@
PRODUCTVERSION @PAL_PLAYER_FIXED_VERSION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Burnout 3 PAL Enhanced"
      VALUE "ProductName", "Burnout 3 PAL Enhanced"
      VALUE "FileVersion", "@PAL_PLAYER_VERSION@"
      VALUE "ProductVersion", "@PAL_PLAYER_VERSION@"
      VALUE "OriginalFilename", "Burnout3-PAL-Enhanced.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
